# Local defaults. Replace BYOK_ENCRYPTION_KEY and AUTH_SECRET before storing a real provider key.
DATABASE_URL=postgres://inbox_app:inbox_app_dev@127.0.0.1:5433/inbox_mychef
KEY_READER_DATABASE_URL=postgres://inbox_key_reader:inbox_key_reader_dev@127.0.0.1:5433/inbox_mychef
MIGRATION_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/inbox_mychef

AUTH_SECRET=LEIRPrNlMaqWsWAa6a2fJqJKUw9Wp1dRFp0sKpk91Pc=
AUTH_URL=http://127.0.0.1:4317
BYOK_ENCRYPTION_KEY=FpgF6r8jukArO7DcBjGEj65TI1eGoWUMqhoTawKC6vY=

# Production auth. When both are unset, sign-in is the Auth.js email fallback.
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Optional. Shown only when both are set.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Optional. When set, POST /api/webhooks/ghl must send this value in
# x-ghl-secret or Authorization: Bearer. When empty, the receive stub accepts
# the body and marks the receipt unverified. It never sends a message.
GHL_WEBHOOK_SECRET=

# Optional. Vercel Cron calls GET /api/cron/learn with Authorization: Bearer this value.
# When empty, the route refuses the request. The pass only proposes pending rows and never sends.
CRON_SECRET=
