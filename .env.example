# Names only. Put real values in .env.local or the Vercel project. Never commit secrets.
#
# Neon / Vercel: use role mychef_runtime for DATABASE_URL and KEY_READER_DATABASE_URL.
# Local Docker: use inbox_app / inbox_key_reader (see docker-compose.yml). Do not point
# MIGRATION_DATABASE_URL at Neon.

# Required
DATABASE_URL=
KEY_READER_DATABASE_URL=
AUTH_SECRET=
BYOK_ENCRYPTION_KEY=
AUTH_URL=http://127.0.0.1:4317
OPERATOR_BOOTSTRAP_EMAIL=bali@mychef.id
OPERATOR_BOOTSTRAP_PASSWORD=

# Optional
CRON_SECRET=
GHL_WEBHOOK_SECRET=

# Local Docker migrations only (not used on Vercel)
MIGRATION_DATABASE_URL=

# Generate AUTH_SECRET and BYOK_ENCRYPTION_KEY (32 bytes, base64):
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
